# =============================================================================
# .env.example — шаблон для локальної розробки.
# На Render усі ці значення задаються у Dashboard → Environment або в render.yaml
# (з sync: false для секретів).
# =============================================================================

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.develop
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Локально використовується SQLite (див. config/settings/develop.py).
# На Render DATABASE_URL інжектується автоматично з блоку `databases`.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Cloudinary (медіа з адмінки) -------------------------------------------
# Формат: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# На DigitalOcean Droplet: USE_LOCAL_MEDIA=1, CLOUDINARY_URL не задавати.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
USE_LOCAL_MEDIA=
MEDIA_ROOT=

# --- Gmail SMTP (App Password!) ---------------------------------------------
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=Магазин книжок <your-account@gmail.com>

# --- Сайт --------------------------------------------------------------------
# Production: ofion.com.ua (без www). www редіректиться 301 на цей хост.
SITE_DOMAIN=localhost:8000
SITE_PROTOCOL=http

# --- Платежі -----------------------------------------------------------------
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
MONOBANK_TOKEN=

# --- Доставка ----------------------------------------------------------------
NOVAPOSHTA_API_KEY=

# --- Месенджери --------------------------------------------------------------
TELEGRAM_BOT_USERNAME=
VIBER_BOT_URI=

# --- Gunicorn (тільки production) -------------------------------------------
WEB_CONCURRENCY=3
WEB_THREADS=2

# --- Observability (опційно) -------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production
