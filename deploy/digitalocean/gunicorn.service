# /etc/systemd/system/bookshop.service
# sudo systemctl daemon-reload
# sudo systemctl enable --now bookshop

[Unit]
Description=OFION bookshop (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/bookshop
EnvironmentFile=/var/www/bookshop/.env
ExecStart=/var/www/bookshop/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers ${WEB_CONCURRENCY:-2} \
    --threads ${WEB_THREADS:-2} \
    --worker-class gthread \
    --timeout 120 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
