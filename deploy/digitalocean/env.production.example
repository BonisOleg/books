# Скопіювати на сервер як /var/www/bookshop/.env
# cp deploy/digitalocean/env.production.example /var/www/bookshop/.env

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=згенеруйте-довгий-випадковий-ключ
DJANGO_LOG_LEVEL=INFO

DJANGO_ALLOWED_HOSTS=ofion.com.ua,www.ofion.com.ua,46.101.244.48
CSRF_TRUSTED_ORIGINS=https://ofion.com.ua,https://www.ofion.com.ua,http://46.101.244.48
CUSTOM_DOMAIN=ofion.com.ua
SITE_DOMAIN=ofion.com.ua
SITE_PROTOCOL=https

# До certbot: false (інакше HTTP → HTTPS редірект на неіснуючий 443).
# Після certbot: true
SECURE_SSL_REDIRECT=false

# Postgres на Droplet (або Managed DB — підставте свій URL)
DATABASE_URL=postgres://bookshop:ПАРОЛЬ@127.0.0.1:5432/bookshop

# Медіа на диску (без Cloudinary)
USE_LOCAL_MEDIA=1
MEDIA_ROOT=/var/www/bookshop/media

# Email — скопіюйте з Render Environment
RESEND_API_KEY=
DEFAULT_FROM_EMAIL="noreply@ofion.com.ua"
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Платежі / доставка — скопіюйте з Render
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
MONOBANK_TOKEN=
NOVAPOSHTA_API_KEY=
TELEGRAM_BOT_USERNAME=
VIBER_BOT_URI=

# Gunicorn — для Droplet 2 GB RAM
WEB_CONCURRENCY=2
WEB_THREADS=2
